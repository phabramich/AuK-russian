+    def _collate_cached(self, batch):
+        def pad_stack(tensors):
+            mx = max(t.shape[0] for t in tensors)
+            return torch.stack([torch.nn.functional.pad(t, (0, 0, 0, mx - t.shape[0])) for t in tensors])
+        latent = pad_stack([b["latent"] for b in batch])
+        ref_latent = pad_stack([b["ref_latent"] for b in batch])
+        text_embeds = pad_stack([b["text_embeds"] for b in batch])
+        latent_lens = torch.stack([b["latent_len"] for b in batch]).long()
+        ref_lens = torch.stack([b["ref_len"] for b in batch]).long()
+        text_lens = torch.stack([b["text_len"] for b in batch]).long()
+        context_mask = torch.arange(text_embeds.shape[1])[None, :] < text_lens[:, None]
+        cond_inputs = {"text_embeds": text_embeds, "context_mask": context_mask,
+                       "input_ids": torch.zeros(len(batch), text_embeds.shape[1], dtype=torch.long)}
+        return {"latent": latent, "latent_lens": latent_lens, "ref_latent": ref_latent,
+                "ref_lens": ref_lens, "cond_inputs": cond_inputs,
+                "messages": [b["messages"] for b in batch]}
+
 
